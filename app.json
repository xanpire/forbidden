{
  "expo": {
    "name": "frbddn",
    "slug": "frbddn",
    "version": "2.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frbddn",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050505",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.frbddn.app"
    },
    "android": {
      "package": "com.frbddn.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A0A0A"
      },
      "edgeToEdgeEnabled": true
    },
    "androidStatusBar": {
      "backgroundColor": "#050505",
      "barStyle": "light-content"
    },
    "androidNavigationBar": {
      "backgroundColor": "#050505",
      "barStyle": "light-content"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "frbddn \u2014 Sandbox Roleplay",
      "shortName": "frbddn",
      "lang": "en",
      "scope": "/",
      "startUrl": "/",
      "themeColor": "#050505",
      "backgroundColor": "#050505",
      "description": "A sandbox roleplay game: be anyone, in any world you write.",
      "display": "standalone",
      "orientation": "portrait",
      "barStyle": "black-translucent"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050505",
          "image": "./assets/images/icon.png",
          "imageWidth": 144,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}